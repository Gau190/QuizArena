@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="login-page">
    <form class="login-card" method="post" asp-action="Login" novalidate>
        @Html.AntiForgeryToken()
        <div class="brand-row">
            <span class="brand-icon">EH</span>
            <span class="brand-name">ExamHub</span>
        </div>
        <p class="subtitle">Đăng nhập bằng tài khoản được cấp bởi hệ thống.</p>

        @if (ViewBag.Error is string error)
        {
            <div class="alert danger login-alert" role="alert">
                <span class="alert-icon">!</span>
                <span>@error</span>
            </div>
        }

        <label class="field login-field">
            <span>Tên đăng nhập</span>
            <span class="input-shell">
                <span class="input-icon" aria-hidden="true"><i class="fa-solid fa-user"></i></span>
                <input asp-for="Username" autocomplete="username" placeholder="Nhập username..." autofocus />
            </span>
            <span asp-validation-for="Username" class="validation-message"></span>
        </label>

        <label class="field login-field">
            <span>Mật khẩu</span>
            <span class="input-shell">
                <span class="input-icon" aria-hidden="true"><i class="fa-solid fa-lock"></i></span>
                <input asp-for="Password" id="login-password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu..." />
                <button class="password-toggle" type="button" aria-label="Hiện mật khẩu" aria-pressed="false" data-target="login-password">
                    <i class="fa-solid fa-eye" aria-hidden="true"></i>
                </button>
            </span>
            <span asp-validation-for="Password" class="validation-message"></span>
        </label>

        <label class="remember-row">
            <input asp-for="RememberMe" />
            <span>Ghi nhớ đăng nhập</span>
        </label>

        <button class="btn primary full login-submit" type="submit">Đăng nhập</button>
        <p class="hint">Quên mật khẩu? Liên hệ quản trị viên của tổ chức.</p>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login.js" asp-append-version="true"></script>
}
