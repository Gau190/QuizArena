@model IReadOnlyList<Exam>
@{
    ViewData["Title"] = "Bảng điều khiển thí sinh";
    var attempts = (IReadOnlyList<ExamAttempt>)ViewBag.Attempts;
    var completed = attempts.Count(x => x.Score != null);
    var avg = completed == 0 ? 0 : attempts.Where(x => x.Score != null).Average(x => x.Score ?? 0);
}

<section class="dashboard">
    <div class="dash-main">
        <div class="greeting">
            <h1>Chào buổi sáng, @User.FindFirst("full_name")?.Value!</h1>
            <p>Bạn có @Model.Count bài thi đang mở.</p>
        </div>
        <div class="stats-row">
            <div class="stat-box"><span>Bài đã làm</span><b>@completed</b></div>
            <div class="stat-box"><span>Điểm trung bình</span><b>@avg.ToString("0.0")</b></div>
            <div class="stat-box"><span>Bài đang mở</span><b>@Model.Count</b></div>
        </div>
        <h2 class="section-title">Bài thi có sẵn</h2>
        <div class="exam-cards">
            @foreach (var exam in Model)
            {
                <article class="exam-card">
                    <span class="badge subject">@exam.Subject?.Name</span>
                    <h3>@exam.Title</h3>
                    <div class="meta"><span>@exam.DurationMinutes phút</span><span>@(exam.QuestionCount?.ToString() ?? $"{exam.TotalPoints:0.#} điểm")</span></div>
                    <form method="post" asp-action="StartExam" asp-route-examId="@exam.Id">
                        @Html.AntiForgeryToken()
                        <button class="btn primary full" type="submit">Bắt đầu thi</button>
                    </form>
                </article>
            }
        </div>
    </div>
    <aside class="dash-side">
        <h2 class="section-title">Điểm gần đây</h2>
        @foreach (var attempt in attempts.Where(x => x.Score != null).Take(6))
        {
            var percent = attempt.TotalPoints is > 0 ? (attempt.Score ?? 0) / attempt.TotalPoints.Value * 100 : 0;
            <div class="score-item">
                <div><b>@attempt.Exam?.Title</b><span>@((attempt.Score ?? 0).ToString("0.0")) / @((attempt.TotalPoints ?? 10).ToString("0.#"))</span></div>
                <div class="scorebar"><span style="width:@percent.ToString("0")%"></span></div>
            </div>
        }
    </aside>
</section>
