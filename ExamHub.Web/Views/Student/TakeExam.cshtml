@using System.Text.Json
@model QuestionPayload
@{
    ViewData["Title"] = "Làm bài thi";
    var attempt = (ExamAttempt)ViewBag.Attempt;
    var selectedIds = JsonSerializer.Deserialize<List<int>>(Model.CurrentAnswer?.AnswerIds ?? "[]") ?? [];
    var prev = Math.Max(1, Model.Index - 1);
    var next = Math.Min(Model.Total, Model.Index + 1);
}

<section class="exam-shell" data-attempt-id="@attempt.Id" data-question-id="@Model.Question.Id" data-index="@Model.Index">
    <div class="exam-topbar">
        <a class="icon-btn" asp-action="Dashboard">Thoát</a>
        <div><b>@attempt.Exam?.Title</b><span>Câu @Model.Index / @Model.Total</span></div>
        <div class="timer" id="timer-display">--:--</div>
    </div>
    <div class="exam-body">
        <article class="exam-main">
            <div class="q-tags"><span class="badge">@Model.Question.Type</span><span class="badge">@Model.Question.Difficulty</span></div>
            <h1>Câu hỏi @Model.Index</h1>
            <p class="question-text">@Model.Question.Content</p>

            @if (Model.Question.Type == QuestionType.TextAnswer)
            {
                <label class="field wide">
                    <span>Điền vào chỗ trống</span>
                    <input id="text-answer" value="@Model.CurrentAnswer?.TextInput" placeholder="Nhập đáp án..." />
                </label>
            }
            else
            {
                <div class="choice-list">
                    @foreach (var answer in Model.Question.Answers)
                    {
                        var checkedAttr = selectedIds.Contains(answer.Id) ? "checked" : null;
                        <label class="choice">
                            <input type="@(Model.Question.Type == QuestionType.SingleChoice ? "radio" : "checkbox")" name="answerIds" value="@answer.Id" checked="@checkedAttr" />
                            <span>@answer.Content</span>
                        </label>
                    }
                </div>
            }

            <div class="exam-actions">
                <a class="btn ghost" asp-action="TakeExam" asp-route-attemptId="@attempt.Id" asp-route-index="@prev">Câu trước</a>
                <a class="btn primary" asp-action="TakeExam" asp-route-attemptId="@attempt.Id" asp-route-index="@next">Câu tiếp theo</a>
                <button class="btn ghost" type="button" id="mark-btn">Đánh dấu</button>
            </div>
        </article>
        <aside class="exam-side">
            <div class="progress-label"><span>Tiến độ</span><b>@Model.Index/@Model.Total</b></div>
            <div class="progress"><span style="width:@(Model.Index * 100 / Model.Total)%"></span></div>
            <div class="question-grid">
                @for (var i = 1; i <= Model.Total; i++)
                {
                    <a class="q-square @(i == Model.Index ? "current" : "")" asp-action="TakeExam" asp-route-attemptId="@attempt.Id" asp-route-index="@i">@i</a>
                }
            </div>
            <form method="post" asp-action="Submit" asp-route-attemptId="@attempt.Id">
                @Html.AntiForgeryToken()
                <button class="btn danger full" type="submit">Nộp bài thi</button>
            </form>
        </aside>
    </div>
    <div class="anti-cheat" id="anti-cheat" hidden>Cảnh báo 0/3: Chuyển tab sẽ bị ghi nhận vi phạm!</div>
</section>

@section Scripts {
    <script src="~/js/exam.js" asp-append-version="true"></script>
}
