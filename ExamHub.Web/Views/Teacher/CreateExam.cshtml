@{
    ViewData["Title"] = "Tạo kỳ thi";
    var subjects = (IReadOnlyList<Subject>)ViewBag.Subjects;
}

<section class="panel compact">
    <div class="panel-head"><h1>Tạo kỳ thi</h1></div>
    <form class="stack-form" method="post">
        @Html.AntiForgeryToken()
        <label>Môn thi<select name="subjectId">@foreach (var subject in subjects) { <option value="@subject.Id">@subject.Name</option> }</select></label>
        <label>Tiêu đề<input name="title" value="Đại số - Giữa kỳ 2026" required /></label>
        <label>Mô tả<input name="description" /></label>
        <label>Thời lượng phút<input name="durationMinutes" type="number" value="60" min="1" required /></label>
        <label>Chế độ sinh đề<select name="generateMode" asp-items="Html.GetEnumSelectList<GenerateMode>()"></select></label>
        <label>Số câu<input name="questionCount" type="number" value="10" min="1" /></label>
        <label>Tổng điểm<input name="totalPoints" type="number" step="0.25" /></label>
        <label>Bắt đầu<input name="startTime" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required /></label>
        <label>Kết thúc<input name="endTime" type="datetime-local" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm")" required /></label>
        <button class="btn primary" type="submit">Lưu kỳ thi</button>
    </form>
</section>
