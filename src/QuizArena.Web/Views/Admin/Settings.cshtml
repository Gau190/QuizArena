@{
    ViewData["Title"] = "Cài đặt tổ chức";
    var logoUrl = (string?)ViewBag.LogoUrl;
    var organization = (QuizArena.Core.Entities.Organization?)ViewBag.Organization;
}

<section class="feature-shell">
    <div class="feature-head">
        <div>
            <h1>Cài đặt tổ chức</h1>
            <p>Thông tin hiển thị trên học bạ, báo cáo và các cấu hình dùng chung.</p>
        </div>
        <a class="btn ghost" asp-action="Dashboard"><i class="fa-solid fa-arrow-left"></i>Tổng quan</a>
    </div>

    @if (TempData["SettingsMessage"] is string message)
    {
        <div class="alert info">@message</div>
    }

    <div class="settings-layout">
        <aside class="side-menu">
            <b>Tổ chức</b>
            <a class="active" href="#org-info">Thông tin trường</a>
            <a href="#logo-settings">Logo</a>
            <b>Hệ thống</b>
            <a href="#feature-settings">Tính năng thi</a>
        </aside>

        <div class="settings-main">
            <form id="org-info" class="panel" method="post" asp-action="SaveOrganizationInfo">
                @Html.AntiForgeryToken()
                <div class="panel-head tight"><h2>Thông tin tổ chức</h2></div>
                <div class="org-form">
                    <label>Tên trường / Trung tâm<input name="name" value="@(organization?.Name ?? "THPT Chu Văn An")" required /></label>
                    <label>Mã trường<input name="code" value="@(organization?.Code ?? "THPT-CVA-HN01")" required /></label>
                    <label>Địa chỉ<input name="address" value="@(organization?.Address ?? "Đường Thụy Khuê, Tây Hồ, Hà Nội")" /></label>
                    <label>Điện thoại<input name="phone" value="@(organization?.Phone ?? "024 3823 1234")" /></label>
                    <label>Email liên hệ<input name="email" value="@(organization?.Email ?? "contact@chuvan.edu.vn")" /></label>
                    <label>Website<input name="website" value="@(organization?.Website ?? "https://thptchuvan.edu.vn")" /></label>
                    <label class="full">Mô tả ngắn<textarea name="description">@(organization?.Description ?? "Trường THPT Chu Văn An - Hà Nội. Đơn vị trực thuộc Sở GD&ĐT Hà Nội.")</textarea></label>
                </div>
                <div class="form-actions">
                    <button class="btn primary" type="submit"><i class="fa-solid fa-floppy-disk"></i> Lưu thông tin</button>
                </div>
            </form>

            <section id="logo-settings" class="panel">
                <div class="panel-head tight"><h2>Logo tổ chức</h2></div>
                <form class="upload-panel" method="post" asp-action="UploadLogo" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="logo-preview">
                        @if (!string.IsNullOrWhiteSpace(logoUrl))
                        {
                            <img src="@logoUrl" alt="Logo tổ chức" />
                        }
                        else
                        {
                            <span>Q</span>
                        }
                    </div>
                    <div class="upload-copy">
                        <b>Ảnh logo dùng cho học bạ và báo cáo</b>
                        <small>Hỗ trợ JPG, PNG, WEBP. Kích thước tối đa 2MB.</small>
                        <input type="file" name="logo" accept="image/png,image/jpeg,image/webp" />
                    </div>
                    <button class="btn primary" type="submit"><i class="fa-solid fa-upload"></i> Tải lên</button>
                </form>
            </section>

            <form id="feature-settings" class="panel" method="post" asp-action="SaveSettings">
                @Html.AntiForgeryToken()
                <div class="panel-head tight"><h2>Tính năng hệ thống</h2></div>
                <div class="toggle-list">
                    <label><span>Cho xem đáp án sau khi nộp</span><input name="allowViewAnswerAfterSubmit" type="checkbox" value="true" checked="@(organization?.AllowViewAnswerAfterSubmit == true)" /></label>
                    <label><span>Tự động nộp bài khi hết giờ</span><input name="autoSubmitOnTimeout" type="checkbox" value="true" checked="@(organization?.AutoSubmitOnTimeout != false)" /></label>
                    <label><span>Cảnh báo chuyển tab khi thi</span><input name="antiCheatTabSwitch" type="checkbox" value="true" checked="@(organization?.AntiCheatTabSwitch != false)" /></label>
                    <label><span>Xáo trộn câu hỏi</span><input name="shuffleQuestions" type="checkbox" value="true" checked="@(organization?.ShuffleQuestions != false)" /></label>
                    <label><span>Xáo trộn đáp án</span><input name="shuffleAnswers" type="checkbox" value="true" checked="@(organization?.ShuffleAnswers != false)" /></label>
                    <label><span>Chia sẻ ngân hàng câu hỏi trong tổ chức</span><input name="shareQuestionBank" type="checkbox" value="true" checked="@(organization?.ShareQuestionBank != false)" /></label>
                    <label><span>Gửi email khi có kết quả</span><input name="sendEmailOnResult" type="checkbox" value="true" checked="@(organization?.SendEmailOnResult == true)" /></label>
                </div>
                <div class="form-actions">
                    <button class="btn primary" type="submit"><i class="fa-solid fa-sliders"></i> Lưu tính năng</button>
                </div>
            </form>
        </div>
    </div>
</section>
