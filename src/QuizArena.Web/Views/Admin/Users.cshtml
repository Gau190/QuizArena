@model IReadOnlyList<User>
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<section class="panel">
    <div class="panel-head">
        <h1>Quản lý người dùng</h1>
        <form class="toolbar" method="get">
            <input name="q" value="@Context.Request.Query["q"]" placeholder="Tìm theo tên, username..." />
            <select name="role">
                <option value="">Tất cả vai trò</option>
                <option value="Admin">Admin</option>
                <option value="Teacher">Giáo viên</option>
                <option value="Student">Thí sinh</option>
            </select>
            <button class="btn ghost" type="submit">Lọc</button>
        </form>
    </div>

    @if (TempData["AdminMessage"] is string message)
    {
        <div class="alert info">@message</div>
    }

    <form class="inline-form" method="post" asp-action="CreateUser">
        @Html.AntiForgeryToken()
        <input name="username" placeholder="Username" required />
        <input name="fullName" placeholder="Họ tên" required />
        <input name="email" type="email" placeholder="Email" required />
        <input name="password" type="password" placeholder="Mật khẩu" required />
        <select name="role" asp-items="Html.GetEnumSelectList<UserRole>()"></select>
        <button class="btn primary" type="submit">Thêm người dùng</button>
    </form>

    <table class="data-table">
        <thead><tr><th>Người dùng</th><th>Username</th><th>Vai trò</th><th>Trạng thái</th><th>Đăng nhập cuối</th><th>Reset mật khẩu</th><th></th></tr></thead>
        <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>
                    <form id="edit-user-@user.Id" method="post" asp-action="UpdateUser" asp-route-id="@user.Id">
                        @Html.AntiForgeryToken()
                    </form>
                    <div class="person">
                        <span class="avatar">@user.FullName.Split(' ').Last()[0]</span>
                        <div class="inline-edit-stack">
                            <input name="fullName" form="edit-user-@user.Id" value="@user.FullName" required />
                            <input name="email" form="edit-user-@user.Id" type="email" value="@user.Email" required />
                        </div>
                    </div>
                </td>
                <td><input name="username" form="edit-user-@user.Id" value="@user.Username" required /></td>
                <td>
                    <select name="role" form="edit-user-@user.Id">
                        @foreach (var role in Enum.GetValues<UserRole>())
                        {
                            <option value="@role" selected="@(role == user.Role)">@role</option>
                        }
                    </select>
                </td>
                <td><span class="status @(user.IsActive ? "ok" : "danger")"></span>@(user.IsActive ? "Hoạt động" : "Bị khóa")</td>
                <td>@(user.LastLoginAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa có")</td>
                <td>
                    <form class="table-inline-form" method="post" asp-action="ResetUserPassword" asp-route-id="@user.Id">
                        @Html.AntiForgeryToken()
                        <input name="password" type="password" placeholder="Mật khẩu mới" minlength="6" required />
                        <button class="btn ghost" type="submit">Reset</button>
                    </form>
                </td>
                <td>
                    <div class="table-actions">
                        <button class="icon-btn" form="edit-user-@user.Id" type="submit">Lưu</button>
                        <form method="post" asp-action="ToggleUser" asp-route-id="@user.Id">
                            @Html.AntiForgeryToken()
                            <button class="icon-btn" type="submit">@(user.IsActive ? "Khóa" : "Mở")</button>
                        </form>
                        <form method="post" asp-action="DeleteUser" asp-route-id="@user.Id">
                            @Html.AntiForgeryToken()
                            <button class="icon-btn danger" type="submit">Xóa</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</section>
