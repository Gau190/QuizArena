@model IReadOnlyList<Question>
@{
    ViewData["Title"] = "Ngân hàng câu hỏi";
    var subjects = (IReadOnlyList<Subject>)ViewBag.Subjects;
    var selectedSubjectId = (int?)ViewBag.SubjectId;
    var selectedType = (QuestionType?)ViewBag.Type;
    var selectedDifficulty = (Difficulty?)ViewBag.Difficulty;
    var currentUserId = (Guid)ViewBag.CurrentUserId;
}

<section class="panel">
    <div class="panel-head">
        <h1>Ngân hàng câu hỏi</h1>
        <div class="head-actions">
            <div class="tabs">
                <a class="@(selectedType is null ? "active" : "")" asp-action="Questions" asp-route-subjectId="@selectedSubjectId" asp-route-difficulty="@selectedDifficulty" asp-route-q="@ViewBag.Query">Tất cả (@Model.Count)</a>
                <a class="@(selectedType == QuestionType.SingleChoice ? "active" : "")" asp-action="Questions" asp-route-type="@QuestionType.SingleChoice" asp-route-subjectId="@selectedSubjectId" asp-route-difficulty="@selectedDifficulty" asp-route-q="@ViewBag.Query">Một đáp án</a>
                <a class="@(selectedType == QuestionType.MultipleChoice ? "active" : "")" asp-action="Questions" asp-route-type="@QuestionType.MultipleChoice" asp-route-subjectId="@selectedSubjectId" asp-route-difficulty="@selectedDifficulty" asp-route-q="@ViewBag.Query">Nhiều đáp án</a>
                <a class="@(selectedType == QuestionType.TextAnswer ? "active" : "")" asp-action="Questions" asp-route-type="@QuestionType.TextAnswer" asp-route-subjectId="@selectedSubjectId" asp-route-difficulty="@selectedDifficulty" asp-route-q="@ViewBag.Query">Nhập văn bản</a>
            </div>
            <a class="btn ghost" asp-action="WeakQuestions"><i class="fa-solid fa-triangle-exclamation"></i> Câu hỏi yếu</a>
        </div>
    </div>

    @if (TempData["TeacherMessage"] is string message)
    {
        <div class="alert info">@message</div>
    }

    <form class="filters-strip" method="get">
        <input name="q" value="@ViewBag.Query" placeholder="Tìm nội dung câu hỏi..." />
        <select name="subjectId">
            <option value="">Tất cả môn</option>
            @foreach (var subject in subjects)
            {
                <option value="@subject.Id" selected="@(subject.Id == selectedSubjectId)">@System.Net.WebUtility.HtmlDecode(subject.Name)</option>
            }
        </select>
        <select name="type">
            <option value="">Tất cả loại</option>
            @foreach (var type in Enum.GetValues<QuestionType>())
            {
                <option value="@type" selected="@(type == selectedType)">@type</option>
            }
        </select>
        <select name="difficulty">
            <option value="">Tất cả độ khó</option>
            @foreach (var difficulty in Enum.GetValues<Difficulty>())
            {
                <option value="@difficulty" selected="@(difficulty == selectedDifficulty)">@difficulty</option>
            }
        </select>
        <button class="btn ghost" type="submit">Lọc</button>
    </form>

    <form class="question-form" method="post" asp-action="CreateQuestion">
        @Html.AntiForgeryToken()
        <select name="subjectId">@foreach (var subject in subjects) { <option value="@subject.Id">@System.Net.WebUtility.HtmlDecode(subject.Name)</option> }</select>
        <select name="type" asp-items="Html.GetEnumSelectList<QuestionType>()"></select>
        <select name="difficulty" asp-items="Html.GetEnumSelectList<Difficulty>()"></select>
        <input name="points" type="number" min="0.25" step="0.25" value="1" />
        <textarea name="content" placeholder="Nội dung câu hỏi" required></textarea>
        <textarea name="answers" placeholder="Mỗi đáp án một dòng. TextAnswer nhập đáp án chuẩn." required></textarea>
        <input name="correct" placeholder="Đáp án đúng: số thứ tự hoặc nội dung, cách nhau bằng dấu phẩy" required />
        <input name="explanation" placeholder="Giải thích đáp án (không bắt buộc, hiện ở trang xem lại kết quả)" maxlength="1000" />
        <button class="btn primary" type="submit">Thêm câu hỏi</button>
    </form>

    <form class="question-form" method="post" asp-action="ImportQuestions" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <select name="fallbackSubjectId">@foreach (var subject in subjects) { <option value="@subject.Id">@System.Net.WebUtility.HtmlDecode(subject.Name)</option> }</select>
        <input name="file" type="file" accept=".csv,.xlsx" required />
        <span class="muted-help">Header: Type, Difficulty, Points, Content, Answers, Correct, SubjectId/Subject. Answers tách bằng dấu |.</span>
        <button class="btn ghost" type="submit"><i class="fa-solid fa-file-import"></i> Import CSV/XLSX</button>
    </form>

    <div class="question-list">
        @foreach (var question in Model)
        {
            var answerLines = string.Join("\n", question.Answers.OrderBy(x => x.OrderIndex).Select(x => x.Content));
            var correctText = string.Join(",", question.Answers.OrderBy(x => x.OrderIndex).Where(x => x.IsCorrect).Select(x => x.OrderIndex.ToString()));
            var canManage = User.IsInRole(nameof(UserRole.Admin)) || question.CreatedBy == currentUserId;
            <article class="question-item">
                <div class="q-index">Q@(question.Id)</div>
                <div>
                    <div class="q-tags">
                        <span class="badge">@question.Type</span>
                        <span class="badge subject">@System.Net.WebUtility.HtmlDecode(question.Subject?.Name)</span>
                        <span class="badge">@question.Difficulty</span>
                        <span class="badge @(question.IsActive ? "student" : "")">@(question.IsActive ? "Đang dùng" : "Đã tắt")</span>
                    </div>
                    <h3>@question.Content</h3>
                    <div class="answers">
                        @foreach (var answer in question.Answers)
                        {
                            <span class="answer @(answer.IsCorrect ? "correct" : "")">@answer.Content @(answer.IsCorrect ? "✓" : "")</span>
                        }
                    </div>
                    @if (canManage)
                    {
                        <form class="question-edit-form" method="post" asp-action="UpdateQuestion" asp-route-id="@question.Id">
                            @Html.AntiForgeryToken()
                            <select name="subjectId">
                                @foreach (var subject in subjects)
                                {
                                    <option value="@subject.Id" selected="@(subject.Id == question.SubjectId)">@System.Net.WebUtility.HtmlDecode(subject.Name)</option>
                                }
                            </select>
                            <select name="type">
                                @foreach (var type in Enum.GetValues<QuestionType>())
                                {
                                    <option value="@type" selected="@(type == question.Type)">@type</option>
                                }
                            </select>
                            <select name="difficulty">
                                @foreach (var difficulty in Enum.GetValues<Difficulty>())
                                {
                                    <option value="@difficulty" selected="@(difficulty == question.Difficulty)">@difficulty</option>
                                }
                            </select>
                            <input name="points" type="number" min="0.25" step="0.25" value="@question.Points.ToString("0.##")" />
                            <textarea name="content" required>@question.Content</textarea>
                            <textarea name="answers" required>@answerLines</textarea>
                            <input name="correct" value="@correctText" required />
                            <input name="explanation" value="@question.Explanation" placeholder="Giải thích đáp án" maxlength="1000" />
                            <button class="btn ghost" type="submit"><i class="fa-solid fa-floppy-disk"></i> Lưu câu hỏi</button>
                        </form>
                        <div class="table-actions">
                            <form method="post" asp-action="ToggleQuestion" asp-route-id="@question.Id">
                                @Html.AntiForgeryToken()
                                <button class="icon-btn" type="submit">@(question.IsActive ? "Tắt" : "Bật")</button>
                            </form>
                            <form method="post" asp-action="DeleteQuestion" asp-route-id="@question.Id">
                                @Html.AntiForgeryToken()
                                <button class="icon-btn danger" type="submit">Xóa</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <p class="muted-help">Câu hỏi dùng chung. Bạn chỉ có quyền xem, không sửa câu hỏi của giáo viên khác.</p>
                    }
                </div>
            </article>
        }
    </div>
</section>
